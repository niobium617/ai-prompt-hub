.page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #f5f7fa;
  padding: 40rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  width: 100%;
  max-width: 640rpx;
  box-sizing: border-box;
}
.logo {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 48rpx;
}
.inp {
  background: #f5f7fa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.btn { background: #3b82f6; color: #fff; border-radius: 12rpx; margin-top: 24rpx; font-size: 30rpx; height: 88rpx; line-height: 88rpx; }
.switch { text-align: center; margin-top: 24rpx; font-size: 26rpx; color: #999; }
.link { color: #3b82f6; }
.btn-wechat { background: #07c160; color: #fff; border-radius: 12rpx; margin-top: 24rpx; font-size: 30rpx; height: 88rpx; line-height: 88rpx; }
.btn-outline { background: #fff; color: #3b82f6; border: 2rpx solid #3b82f6; border-radius: 12rpx; margin-top: 16rpx; font-size: 28rpx; height: 88rpx; line-height: 88rpx; }
.divider { text-align: center; color: #ccc; font-size: 24rpx; margin: 24rpx 0; }
.dialog-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999; }
.dialog { background: #fff; border-radius: 20rpx; padding: 40rpx 36rpx; width: 86%; max-width: 600rpx; box-sizing: border-box; }
.dialog-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 12rpx; }
.dialog-desc { font-size: 24rpx; color: #999; text-align: center; margin-bottom: 24rpx; }
