.login-page { display: flex; align-items: center; justify-content: center; min-height: 80vh; }
.login-card { width: 100%; background: #fff; border-radius: 24rpx; padding: 48rpx 32rpx; }
.logo { text-align: center; font-size: 36rpx; font-weight: bold; margin-bottom: 48rpx; }
.input { background: #f5f7fa; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 20rpx; font-size: 28rpx; }
.btn { background: #3b82f6; color: #fff; margin-top: 24rpx; border-radius: 12rpx; font-size: 30rpx; }
