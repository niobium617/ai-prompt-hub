.page { min-height: 100vh; background: #f5f7fa; }
.guest { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.avatar-placeholder { font-size: 100rpx; margin-bottom: 24rpx; }
.guest-text { color: #999; font-size: 28rpx; margin-bottom: 32rpx; }
.btn { background: #3b82f6; color: #fff; border-radius: 12rpx; font-size: 30rpx; padding: 20rpx 80rpx; }

.user-card { background: linear-gradient(135deg, #3b82f6, #6366f1); margin: 24rpx; border-radius: 20rpx; padding: 40rpx 32rpx; display: flex; align-items: center; gap: 24rpx; color: #fff; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.nickname { font-size: 34rpx; font-weight: 600; }
.username { font-size: 24rpx; font-weight: 400; opacity: .7; margin-left: 8rpx; }
.points { font-size: 24rpx; opacity: .8; margin-top: 8rpx; }

.menu { background: #fff; margin: 0 24rpx; border-radius: 16rpx; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.menu-item:last-child { border: none; }
.menu-icon { font-size: 34rpx; margin-right: 16rpx; }
.menu-text { flex: 1; font-size: 30rpx; }
.badge { background: #ef4444; color: #fff; font-size: 20rpx; min-width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center; border-radius: 16rpx; padding: 0 8rpx; margin-right: 12rpx; }
.menu-arrow { color: #ccc; font-size: 28rpx; }
.logout { color: #ef4444; text-align: center; justify-content: center; }
.btn::after { border: none; }
