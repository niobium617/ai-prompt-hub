<view class="page">
  <!-- 未登录 -->
  <view wx:if="{{!isLogin}}" class="guest">
    <view class="avatar-placeholder">👤</view>
    <view class="guest-text">登录后查看更多功能</view>
    <button class="btn" bindtap="goLogin">去登录</button>
  </view>

  <!-- 已登录 -->
  <view wx:else>
    <view class="user-card">
      <view class="avatar">{{userInfo && userInfo.nickname ? userInfo.nickname[0] : '?'}}</view>
      <view class="user-info">
        <view class="nickname">
          {{userInfo ? userInfo.nickname : '用户'}}
          <text class="username">@{{userInfo ? userInfo.username : ''}}</text>
        </view>
        <view class="points">投稿 {{stats.prompts}} · 收藏 {{stats.favorites}}</view>
      </view>
    </view>

    <view class="menu">
      <view class="menu-item" bindtap="goNotifications">
        <text class="menu-icon">🔔</text>
        <text class="menu-text">通知中心</text>
        <view wx:if="{{stats.unread > 0}}" class="badge">{{stats.unread > 99 ? '99+' : stats.unread}}</view>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goMyPrompts">
        <text class="menu-icon">📝</text>
        <text class="menu-text">我的投稿</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goDrafts">
        <text class="menu-icon">🔒</text>
        <text class="menu-text">我的草稿</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goFavorites">
        <text class="menu-icon">❤️</text>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goSubmit">
        <text class="menu-icon">📤</text>
        <text class="menu-text">提交提示词</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goTools">
        <text class="menu-icon">🛠️</text>
        <text class="menu-text">AI 工具</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>

    <view class="menu" style="margin-top:24rpx">
      <view class="menu-item logout" bindtap="logout">退出登录</view>
    </view>
  </view>
</view>
