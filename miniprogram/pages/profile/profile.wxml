<view class="container profile-page">
  <view wx:if="{{token}}" class="bg-white menu-list">
    <view class="menu-item" bindtap="onTapFavorites">❤️ 我的收藏</view>
    <view class="menu-item" bindtap="onTapSubmit">📤 提交提示词</view>
    <view class="menu-item" bindtap="onTapHistory">🕐 浏览历史</view>
    <view class="menu-item logout" bindtap="onLogout">退出登录</view>
  </view>
  <view wx:else class="empty-state" style="margin-top: 120rpx;">
    <text class="icon">👤</text>
    <text>尚未登录</text>
    <button class="btn" bindtap="onLogin" style="margin-top: 24rpx;">去登录</button>
  </view>
</view>
