<view class="page">
  <!-- 未登录 -->
  <view wx:if="{{!isLogin}}" class="guest">
    <view class="avatar-placeholder">👤</view>
    <view class="guest-text">登录后查看更多功能</view>
    <button class="btn" bindtap="goLogin">去登录</button>
  </view>

  <!-- 已登录 -->
  <view wx:else>
    <view class="user-card">
      <view class="avatar">{{userInfo?.nickname?.[0] || '?'}}</view>
      <view class="user-info">
        <view class="nickname">{{userInfo?.nickname || '用户'}}</view>
        <view class="points">积分 {{stats.prompts}} · 收藏 {{stats.favorites}}</view>
      </view>
    </view>

    <view class="menu">
      <view class="menu-item" bindtap="goFavorites">
        <text class="menu-icon">❤️</text>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goSubmit">
        <text class="menu-icon">📤</text>
        <text class="menu-text">提交提示词</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goTools">
        <text class="menu-icon">🛠️</text>
        <text class="menu-text">AI 工具</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>

    <view class="menu" style="margin-top:24rpx">
      <view class="menu-item logout" bindtap="logout">退出登录</view>
    </view>
  </view>
</view>
