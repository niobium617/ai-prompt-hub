.page { padding-bottom: 40rpx; }
.search-bar { padding: 16rpx 24rpx; background: #fff; }
.search-box { display: flex; align-items: center; background: #f5f7fa; border-radius: 40rpx; padding: 14rpx 24rpx; }
.search-icon { margin-right: 12rpx; font-size: 30rpx; }
.search-input { flex: 1; font-size: 28rpx; }

.banner { margin: 16rpx 24rpx; background: linear-gradient(135deg, #3b82f6, #6366f1); border-radius: 24rpx; padding: 48rpx 32rpx; color: #fff; }
.banner-title { font-size: 36rpx; font-weight: bold; margin-bottom: 12rpx; }
.banner-desc { font-size: 26rpx; opacity: 0.9; }

.section { padding: 0 24rpx; margin-top: 32rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; }

.category-scroll { white-space: nowrap; padding: 8rpx 0; }
.cat-item { display: inline-flex; flex-direction: column; align-items: center; margin-right: 32rpx; width: 120rpx; }
.cat-icon { font-size: 44rpx; margin-bottom: 8rpx; }
.cat-name { font-size: 22rpx; color: #666; }

.tool-entry { display: flex; align-items: center; margin: 24rpx 24rpx; background: linear-gradient(135deg, #eff6ff, #e0e7ff); border-radius: 16rpx; padding: 24rpx; }
.tool-icon { font-size: 36rpx; margin-right: 16rpx; }
.tool-text { flex: 1; font-size: 28rpx; color: #3b82f6; font-weight: 500; }
.tool-arrow { color: #3b82f6; font-size: 28rpx; }

.prompt-list { }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12rpx; }
.card-title { font-size: 28rpx; font-weight: 600; flex: 1; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.card-desc { font-size: 24rpx; color: #999; margin-bottom: 12rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.card-foot { font-size: 22rpx; color: #bbb; }

.tag { padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 20rpx; margin-left: 12rpx; white-space: nowrap; }
.tag-green { background: #f0fdf4; color: #22c55e; }
.tag-orange { background: #fffbeb; color: #f59e0b; }
.tag-red { background: #fef2f2; color: #ef4444; }

.empty { text-align: center; color: #ccc; padding: 60rpx 0; font-size: 26rpx; }
