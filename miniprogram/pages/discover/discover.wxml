<view class="page">
  <!-- 官方置顶 Skill 项目 -->
  <view class="official-card">
    <view class="official-badge">📌 官方 · 置顶</view>
    <view class="official-title">🔬 Prompt 逆向工程 Skill</view>
    <view class="official-desc">官方发布的 Claude Skill：从 AI 输出逆向还原生成提示词，快速提取高质量 Prompt 技巧。</view>
    <view class="official-foot" bindtap="copySkillLink">
      <text class="official-link">🐙 github.com/niobium617/prompt-reverse-engineer-skill</text>
      <text class="official-copy">复制链接</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">🔥 热门标签</view>
    <view class="tag-cloud">
      <text class="tag" wx:for="{{tags}}" wx:key="id" bindtap="goSearch" data-tag="{{item.name}}">{{item.name}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">📈 最新上线</view>
    <view wx:if="{{newPrompts.length===0}}" class="empty">暂无数据</view>
    <view class="card" wx:for="{{newPrompts}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.description}}</view>
      <view class="card-foot">📁 {{item.category ? item.category.name : ''}} · {{item.createdAt}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">🏆 热度排行</view>
    <view class="card" wx:for="{{hotPrompts}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="rank">#{{index+1}}</view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-foot">👁 {{item.viewCount}} · ⭐ {{item.ratingAvg}}</view>
    </view>
  </view>
</view>
