<view class="page">
  <view class="left-panel">
    <view class="cat-item {{!selectedId ? 'active' : ''}}" bindtap="onSelectCat" data-id="{{0}}">
      <text>全部</text>
    </view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-item {{selectedId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelectCat"
    >
      <text>{{item.name}}</text>
    </view>
  </view>
  <view class="right-panel">
    <view wx:if="{{loading}}" class="loading">加载中...</view>
    <view wx:elif="{{!prompts.length}}" class="empty">
      <text class="empty-icon">📭</text>
      <text>暂无提示词</text>
    </view>
    <view wx:else>
      <view
        wx:for="{{prompts}}"
        wx:key="id"
        class="card"
        bindtap="onTapPrompt"
        data-id="{{item.id}}"
      >
        <view class="card-header">
          <view class="card-title">{{item.title}}</view>
          <view class="tag tag-{{item.difficulty === 1 ? 'green' : item.difficulty === 2 ? 'orange' : 'red'}}">
            {{item.difficulty === 1 ? '入门' : item.difficulty === 2 ? '进阶' : '高级'}}
          </view>
        </view>
        <view class="card-desc">{{item.description}}</view>
        <view class="card-foot">👁 {{item.viewCount}} · ⭐ {{item.ratingAvg}}</view>
      </view>
      <!-- 加载更多状态 -->
      <view wx:if="{{loading}}" class="load-more">加载中...</view>
      <view wx:elif="{{hasMore}}" class="load-more">上拉加载更多</view>
      <view wx:else class="load-more">共 {{total}} 条 · 已全部加载</view>
    </view>
  </view>
</view>
