<view wx:if="{{prompt}}" class="page">
  <!-- 标题区 -->
  <view class="header">
    <view class="tags">
      <text class="tag tag-blue">{{prompt.category?.name}}</text>
      <text class="tag tag-{{prompt.difficulty===1?'green':prompt.difficulty===2?'orange':'red'}}">{{prompt.difficulty===1?'入门':prompt.difficulty===2?'进阶':'高级'}}</text>
      <text wx:if="{{prompt.isFeatured}}" class="tag tag-gold">精选</text>
    </view>
    <view class="title">{{prompt.title}}</view>
    <view class="desc">{{prompt.description}}</view>
    <view class="meta">👁 {{prompt.viewCount}}  ⭐ {{prompt.ratingAvg}}  ❤ {{prompt.favoriteCount}}  📋 {{prompt.useCount}}</view>
  </view>

  <!-- Prompt 内容 -->
  <view class="section">
    <view class="section-title">📝 Prompt 内容</view>
    <view class="code-block">{{prompt.content}}</view>
    <view class="actions">
      <button class="btn-primary" bindtap="onCopy">📋 一键复制</button>
      <button class="btn-outline" bindtap="onFav">{{isFav ? '❤️ 已收藏' : '🤍 收藏'}}</button>
    </view>
  </view>

  <!-- 评分 -->
  <view class="section">
    <view class="section-title">⭐ 评分</view>
    <view class="stars">
      <text wx:for="{{5}}" wx:key="*this" data-score="{{index+1}}" bindtap="onRate" class="star {{index < userRating ? 'on' : ''}}">{{index < userRating ? '★' : '☆'}}</text>
      <text class="rate-text">{{prompt.ratingAvg}}分 ({{prompt.ratingCount}}人)</text>
    </view>
  </view>

  <!-- 评论 -->
  <view class="section">
    <view class="section-title">💬 评论 ({{comments.length}})</view>
    <view class="comment-input">
      <input placeholder="写评论..." value="{{commentText}}" bindinput="onCmtInput" confirm-type="send" bindconfirm="onSubmitComment" />
      <button class="btn-send" bindtap="onSubmitComment">发送</button>
    </view>
    <view wx:for="{{comments}}" wx:key="id" class="comment">
      <view class="cmt-user">{{item.user?.nickname || '匿名'}} <text class="cmt-time">{{item.createdAt?.slice(0,10)}}</text></view>
      <view class="cmt-text">{{item.content}}</view>
      <view class="cmt-like">👍 {{item.likeCount}}</view>
    </view>
  </view>
</view>
