.search-box { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.search-box input { flex: 1; background: #fff; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; height: 80rpx; line-height: 80rpx; box-sizing: border-box; }
.search-box button { background: #3b82f6; color: #fff; font-size: 28rpx; border-radius: 12rpx; }
