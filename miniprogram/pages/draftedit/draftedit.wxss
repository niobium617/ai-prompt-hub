.page { background: #f5f7fa; min-height: 100vh; }
.tabs { display: flex; background: #fff; padding: 8rpx 24rpx; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #999; border-bottom: 4rpx solid transparent; }
.tab.active { color: #3b82f6; border-bottom-color: #3b82f6; font-weight: 600; }

.panel { padding: 24rpx; }
.label { font-size: 28rpx; font-weight: 600; margin: 20rpx 0 12rpx; }
.inp {
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.area {
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 140rpx;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.area.tall { min-height: 400rpx; }

.btn-save,
.btn-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 1;
  border-radius: 12rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 32rpx;
}
.btn-save::after,
.btn-delete::after { border: none; }
.btn-save { background: #3b82f6; color: #fff; }
.btn-delete { background: #fff; color: #ef4444; border: 2rpx solid #ef4444; margin-top: 16rpx; }

.readonly-badge {
  display: inline-block;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}
.source-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.source-desc { font-size: 26rpx; color: #999; margin-bottom: 16rpx; }
.code-block {
  background: #1e293b;
  color: #4ade80;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}
.tip { font-size: 22rpx; color: #bbb; margin-top: 16rpx; text-align: center; }
