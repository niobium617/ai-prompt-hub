.page { padding: 24rpx; background: #f5f7fa; min-height: 100vh; }
.form { background: #fff; border-radius: 16rpx; padding: 32rpx 24rpx; }
.form-item { margin-bottom: 28rpx; }
.label { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.req { color: #ef4444; }
input, .picker {
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
textarea {
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 160rpx;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.btn { background: #3b82f6; color: #fff; border-radius: 12rpx; margin-top: 16rpx; font-size: 30rpx; }
.opt { font-weight: 400; font-size: 22rpx; color: #999; margin-left: 8rpx; }
.img-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-item { position: relative; width: 160rpx; height: 160rpx; }
.img-item image { width: 100%; height: 100%; border-radius: 12rpx; }
.img-remove { position: absolute; top: -12rpx; right: -12rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #ef4444; color: #fff; font-size: 26rpx; text-align: center; line-height: 36rpx; }
.img-add { width: 160rpx; height: 160rpx; border: 2rpx dashed #d1d5db; border-radius: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #999; }
.add-icon { font-size: 48rpx; }
.add-text { font-size: 22rpx; margin-top: 4rpx; }
