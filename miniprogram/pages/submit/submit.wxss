.page { padding: 24rpx; background: #f5f7fa; min-height: 100vh; }
.form { background: #fff; border-radius: 16rpx; padding: 32rpx 24rpx; }
.form-item { margin-bottom: 28rpx; }
.label { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.req { color: #ef4444; }
input, textarea, .picker { background: #f5f7fa; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
textarea { min-height: 100rpx; }
.btn { background: #3b82f6; color: #fff; border-radius: 12rpx; margin-top: 16rpx; font-size: 30rpx; }
