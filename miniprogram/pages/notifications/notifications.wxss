.page { padding: 24rpx; background: #f5f7fa; min-height: 100vh; box-sizing: border-box; }
.topbar { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: #999; margin-bottom: 16rpx; }
.mark-all { color: #3b82f6; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.card.unread { background: #eff6ff; border: 2rpx solid #bfdbfe; }
.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; display: flex; align-items: center; gap: 8rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #3b82f6; }
.card-content { font-size: 26rpx; color: #666; line-height: 1.5; margin-bottom: 8rpx; }
.card-time { font-size: 22rpx; color: #bbb; }
.empty { text-align: center; color: #bbb; padding: 100rpx 0; font-size: 26rpx; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }
