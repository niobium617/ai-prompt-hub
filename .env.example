# ==================== 数据库 ====================
DATABASE_URL="mysql://root:password@localhost:3306/ai_prompt_hub"

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== Elasticsearch ====================
ES_NODE=http://localhost:9200

# ==================== JWT ====================
JWT_ACCESS_SECRET=REMOVED-SECRET
JWT_REFRESH_SECRET=REMOVED-SECRET
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ==================== LLM API ====================
LLM_API_KEY=your-api-key
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# ==================== 微信小程序 ====================
WECHAT_APP_ID=REMOVED-SECRET
WECHAT_APP_SECRET=REMOVED-SECRET

# ==================== 上传 ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ==================== 服务器 ====================
PORT=3000
NODE_ENV=development
