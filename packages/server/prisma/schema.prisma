generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  phone        String?
  passwordHash String    @map("password_hash")
  nickname     String
  avatarUrl    String?   @map("avatar_url")
  bio          String?
  level        Int       @default(1)
  points       Int       @default(0)
  role         String    @default("user")
  status       Int       @default(1)
  wechatOpenid String?   @unique @map("wechat_openid")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  prompts     Prompt[]
  articles    Article[]
  comments    Comment[]
  favorites   Favorite[]
  ratings     Rating[]
  viewHistory ViewHistory[]
  notifications Notification[]
  drafts      PromptDraft[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Prompt {
  id            Int   @id @default(autoincrement())
  title         String
  description   String
  content       String
  categoryId    Int      @map("category_id")
  authorId      Int      @map("author_id")
  aiToolIds     String?  @map("ai_tool_ids")
  difficulty    Int      @default(1)
  exampleImages String?  @map("example_images")
  status        Int      @default(0)
  viewCount     Int      @default(0) @map("view_count")
  useCount      Int      @default(0) @map("use_count")
  favoriteCount Int      @default(0) @map("favorite_count")
  ratingAvg     Float    @default(0) @map("rating_avg")
  ratingCount   Int      @default(0) @map("rating_count")
  isFeatured    Int      @default(0) @map("is_featured")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  publishedAt   DateTime? @map("published_at")

  category Category    @relation(fields: [categoryId], references: [id])
  author   User        @relation(fields: [authorId], references: [id])
  tags     PromptTag[]
  ratings  Rating[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([viewCount])
  @@index([createdAt])
  @@map("prompts")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  parentId  Int?      @map("parent_id")
  icon      String?
  sortOrder Int       @default(0) @map("sort_order")
  status    Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  prompts  Prompt[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String      @unique
  useCount  Int         @default(0) @map("use_count")
  createdAt DateTime    @default(now()) @map("created_at")

  prompts PromptTag[]

  @@index([useCount])
  @@map("tags")
}

model PromptTag {
  promptId Int @map("prompt_id")
  tagId    Int @map("tag_id")

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
  @@map("prompt_tags")
}

model Article {
  id               Int      @id @default(autoincrement())
  title            String
  summary          String
  content          String
  coverImage       String?   @map("cover_image")
  authorId         Int       @map("author_id")
  categoryId       Int?      @map("category_id")
  tagIds           String?   @map("tag_ids")
  chapterStructure String?   @map("chapter_structure")
  viewCount        Int       @default(0) @map("view_count")
  status           Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  publishedAt      DateTime? @map("published_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("articles")
}

model Comment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  targetType String   @map("target_type")
  targetId   Int      @map("target_id")
  parentId   Int?     @map("parent_id")
  content    String
  likeCount  Int      @default(0) @map("like_count")
  status     Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([targetType, targetId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model Favorite {
  id         Int   @id @default(autoincrement())
  userId     Int      @map("user_id")
  targetType String   @map("target_type")
  targetId   Int      @map("target_id")
  folderId   Int?     @map("folder_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("favorites")
}

model Rating {
  id        Int   @id @default(autoincrement())
  userId    Int      @map("user_id")
  promptId  Int   @map("prompt_id")
  score     Int
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@map("ratings")
}

model ViewHistory {
  id         Int   @id @default(autoincrement())
  userId     Int      @map("user_id")
  targetType String   @map("target_type")
  targetId   Int      @map("target_id")
  viewedAt   DateTime @default(now()) @map("viewed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, viewedAt])
  @@map("view_history")
}

model AITool {
  id          Int  @id @default(autoincrement())
  name        String
  logoUrl     String? @map("logo_url")
  category    String
  description String?
  officialUrl String? @map("official_url")
  sortOrder   Int     @default(0) @map("sort_order")
  status      Int     @default(1)

  @@index([category])
  @@index([status])
  @@map("ai_tools")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  title     String
  content   String
  isRead    Int      @default(0) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model PromptDraft {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  sourcePromptId Int      @map("source_prompt_id")
  title          String
  description    String
  content        String
  aiToolIds      String?  @map("ai_tool_ids")
  difficulty     Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sourcePromptId])
  @@map("prompt_drafts")
}
