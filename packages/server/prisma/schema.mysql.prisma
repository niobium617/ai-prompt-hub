generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  nickname     String    @db.VarChar(50)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  bio          String?   @db.VarChar(200)
  level        Int       @default(1) @db.TinyInt
  points       Int       @default(0)
  role         String    @default("user") @db.VarChar(20)
  status       Int       @default(1) @db.TinyInt
  wechatOpenid String?   @map("wechat_openid") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  prompts     Prompt[]
  articles    Article[]
  comments    Comment[]
  favorites   Favorite[]
  ratings     Rating[]
  viewHistory ViewHistory[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Prompt {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(200)
  description   String    @db.Text
  content       String    @db.LongText
  categoryId    Int       @map("category_id")
  authorId      Int       @map("author_id")
  aiToolIds     Json?     @map("ai_tool_ids")
  difficulty    Int       @default(1) @db.TinyInt
  exampleImages Json?     @map("example_images")
  status        Int       @default(0) @db.TinyInt
  viewCount     Int       @default(0) @map("view_count")
  useCount      Int       @default(0) @map("use_count")
  favoriteCount Int       @default(0) @map("favorite_count")
  ratingAvg     Decimal   @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount   Int       @default(0) @map("rating_count")
  isFeatured    Int       @default(0) @map("is_featured") @db.TinyInt
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  publishedAt   DateTime? @map("published_at")

  category Category    @relation(fields: [categoryId], references: [id])
  author   User        @relation(fields: [authorId], references: [id])
  tags     PromptTag[]
  ratings  Rating[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([viewCount])
  @@index([createdAt])
  @@map("prompts")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(50)
  parentId  Int?      @map("parent_id")
  icon      String?   @db.VarChar(50)
  sortOrder Int       @default(0) @map("sort_order")
  status    Int       @default(1) @db.TinyInt
  createdAt DateTime  @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  prompts  Prompt[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(30)
  useCount  Int      @default(0) @map("use_count")
  createdAt DateTime @default(now()) @map("created_at")

  prompts PromptTag[]

  @@index([useCount])
  @@map("tags")
}

model PromptTag {
  promptId Int @map("prompt_id")
  tagId    Int @map("tag_id")

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
  @@map("prompt_tags")
}

model Article {
  id               Int       @id @default(autoincrement())
  title            String    @db.VarChar(200)
  summary          String    @db.VarChar(500)
  content          String    @db.LongText
  coverImage       String?   @map("cover_image") @db.VarChar(500)
  authorId         Int       @map("author_id")
  categoryId       Int?      @map("category_id")
  tagIds           Json?     @map("tag_ids")
  chapterStructure Json?     @map("chapter_structure")
  viewCount        Int       @default(0) @map("view_count")
  status           Int       @default(0) @db.TinyInt
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  publishedAt      DateTime? @map("published_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("articles")
}

model Comment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   Int      @map("target_id")
  parentId   Int?     @map("parent_id")
  content    String   @db.Text
  likeCount  Int      @default(0) @map("like_count")
  status     Int      @default(1) @db.TinyInt
  createdAt  DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([targetType, targetId])
  @@index([userId])
  @@map("comments")
}

model Favorite {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   Int      @map("target_id")
  folderId   Int?     @map("folder_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("favorites")
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  promptId  Int      @map("prompt_id")
  score     Int      @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@map("ratings")
}

model ViewHistory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   Int      @map("target_id")
  viewedAt   DateTime @default(now()) @map("viewed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("view_history")
}

model AITool {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(50)
  logoUrl     String? @map("logo_url") @db.VarChar(500)
  category    String  @db.VarChar(20)
  description String? @db.VarChar(500)
  officialUrl String? @map("official_url") @db.VarChar(500)
  sortOrder   Int     @default(0) @map("sort_order")
  status      Int     @default(1) @db.TinyInt

  @@index([category])
  @@map("ai_tools")
}
